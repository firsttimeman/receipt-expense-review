# fake is the safe default and requires no external credentials.
RECEIPT_EXTRACTOR_PROVIDER=fake

# Set these only when explicitly selecting the OpenAI adapter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

DB_URL=jdbc:mysql://localhost:3306/receipt_review?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=utf8
DB_USERNAME=receipt_user
DB_PASSWORD=receipt_password
REDIS_HOST=localhost
REDIS_PORT=6379
