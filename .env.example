# fake is the safe default and requires no external credentials.
RECEIPT_EXTRACTOR_PROVIDER=fake

# Set these only when explicitly selecting the OpenAI adapter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_CONNECT_TIMEOUT=3s
OPENAI_RESPONSE_TIMEOUT=30s
DB_URL=jdbc:mysql://localhost:3307/receipt_review?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=utf8
DB_USERNAME=receipt_user
DB_PASSWORD=receipt_password
REDIS_HOST=localhost
REDIS_PORT=6379
# 같은 ERP 서버들은 동일한 Redis와 namespace를 사용합니다.
SESSION_REDIS_NAMESPACE=receipt:session
SESSION_TIMEOUT=30m

# 영수증 원본은 S3에 저장합니다. 버킷 이름은 필수이며, 모든 서버에서 같은 bucket/region/prefix를 사용합니다.
# 버킷은 미리 준비하며, 앱의 IAM 역할에는 해당 prefix의 s3:PutObject / s3:GetObject 권한이 필요합니다.
# 자격 증명은 IAM 역할 또는 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN으로 전달합니다.
# 실제 AWS 키를 이 파일에 저장하지 않습니다.
RECEIPT_S3_BUCKET=
RECEIPT_S3_REGION=ap-northeast-2
RECEIPT_S3_PREFIX=receipt-images
# AWS S3에서는 endpoint를 비워두고 path-style-access=false를 사용합니다.
# 로컬 S3 호환 서버를 쓸 때만 endpoint와 path-style-access=true를 지정합니다.
RECEIPT_S3_ENDPOINT=
RECEIPT_S3_PATH_STYLE_ACCESS=false
RECEIPT_S3_CONNECT_TIMEOUT=3s
RECEIPT_S3_READ_TIMEOUT=10s
RECEIPT_S3_REQUEST_TIMEOUT=15s

# MySQL 작업 큐 Worker 설정
RECEIPT_WORKER_ENABLED=true
RECEIPT_WORKER_POLL_DELAY_MILLIS=1000
RECEIPT_WORKER_LEASE_DURATION=60s
RECEIPT_WORKER_BATCH_SIZE=4
RECEIPT_WORKER_CONCURRENCY=4
# 비워두면 애플리케이션 시작 시 고유 ID를 자동 생성합니다.
RECEIPT_WORKER_ID=

# HTTPS 환경에서는 true. localhost HTTP 개발에서만 false를 사용합니다.
SESSION_COOKIE_SECURE=false
# 최초 관리자 준비는 README의 오프라인 CLI 절차로 한 번만 실행합니다.
# 비밀번호 또는 bootstrap 활성화 설정을 이 파일에 저장하지 않습니다.
