{
  "uid": "receipt-worker-comparison",
  "title": "영수증 Worker 동시 처리 반복 비교",
  "description": "Fake 지연 2초, 3건/초, 60초를 4·6·8개 각각 3회 반복. 준비 부하 30초는 제외. 개별 상세 그래프는 기존 영수증 부하테스트 대시보드에서 run_id로 조회합니다.",
  "tags": [
    "receipt",
    "loadtest",
    "comparison"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "experiment_id",
        "label": "실험",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "receipt-loadtest-influx"
        },
        "query": "SHOW TAG VALUES FROM \"receipt_worker_repeat_summary\" WITH KEY = \"experiment_id\"",
        "refresh": 1,
        "sort": 2,
        "multi": false,
        "includeAll": false,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "완료 p95 — 3회 중앙값",
      "description": "각 실행의 지표를 먼저 구한 뒤 3회 중앙값으로 비교합니다. 완료 p95 중앙값은 모든 요청을 합쳐 구한 p95와 다릅니다. 자원은 60초 제출 구간 표본입니다.",
      "datasource": {
        "type": "influxdb",
        "uid": "receipt-loadtest-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "receipt-loadtest-influx"
          },
          "rawQuery": true,
          "query": "SELECT last(\"completion_p95_seconds\") FROM \"receipt_worker_repeat_summary\" WHERE \"experiment_id\" =~ /^$experiment_id$/ AND $timeFilter GROUP BY \"concurrency\"",
          "resultFormat": "time_series",
          "alias": "동시 처리 $tag_concurrency개"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
