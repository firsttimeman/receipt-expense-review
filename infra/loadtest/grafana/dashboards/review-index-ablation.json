          "rawQuery": true,
          "query": "SELECT percentile(\"value\",95) AS \"p95\", percentile(\"value\",99) AS \"p99\" FROM \"receipt_review_ms\" WHERE \"run_id\" =~ /^$run_id$/ AND $timeFilter GROUP BY time(10s) fill(null)",
