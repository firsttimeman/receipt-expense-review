{
  "uid": "receipt-duplicates",
  "title": "영수증 동일 이미지 동시 제출 검증",
  "description": "10·50개 동시 제출, 같은 키/다른 키/키 없음/다른 직원. 실제 MySQL+Redis, Fake 2초, Worker 4개, 로컬 S3Mock.",
  "tags": [
    "receipt",
    "loadtest",
    "duplicates"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "experiment_id",
        "label": "실험",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "receipt-loadtest-influx"
        },
        "query": "SHOW TAG VALUES FROM \"receipt_duplicate_http\" WITH KEY = \"experiment_id\"",
        "refresh": 1,
        "sort": 2,
        "multi": false,
        "includeAll": false,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "전체 제출 요청",
      "datasource": {
        "type": "influxdb",
        "uid": "receipt-loadtest-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "receipt-loadtest-influx"
          },
          "rawQuery": true,
          "query": "SELECT sum(\"requests\") FROM \"receipt_duplicate_http\" WHERE \"experiment_id\" =~ /^$experiment_id$/ AND $timeFilter",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
