          "rawQuery": true,
          "query": "SELECT max(\"app_connections\") AS \"열린 연결\", max(\"app_query_active\") AS \"SQL 실행 중\" FROM \"receipt_db_connections\" WHERE \"run_id\" =~ /^$run_id$/ AND $timeFilter GROUP BY time(2s) fill(null)",
