            "type": "influxdb",
            "uid": "receipt-loadtest-influx"
          },
          "rawQuery": true,
          "query": "SELECT median(\"p95_ms\") FROM \"receipt_review_comparison_summary\" WHERE \"comparison_id\" =~ /^$comparison_id$/ AND \"phase\" =~ /^(before|after)$/ GROUP BY \"phase\",\"dataset\",\"scenario\"",
          "resultFormat": "time_series",
          "alias": "$tag_phase · $tag_dataset 건 · $tag_scenario"
