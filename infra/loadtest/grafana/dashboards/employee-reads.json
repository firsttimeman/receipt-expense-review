{
  "uid": "receipt-employee-reads",
  "title": "영수증 직원 조회 재사용 — 개선 전후 비교",
  "description": "같은 완료 영수증 상세 GET. 직원 조회를 요청 내 재사용하는 변경만 비교합니다. 집계는 MySQL performance_schema 차분과 k6 원시 표본으로 검증합니다.",
  "tags": [
    "receipt",
    "loadtest",
    "employee-read"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "experiment_id",
        "label": "실험",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "receipt-loadtest-influx"
        },
        "query": "SHOW TAG VALUES FROM \"receipt_read_summary\" WITH KEY=\"experiment_id\"",
        "refresh": 1,
        "sort": 2,
        "multi": false,
        "includeAll": false,
        "options": []
      },
      {
        "name": "run_id",
        "label": "상세 실행",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "receipt-loadtest-influx"
        },
        "query": "SHOW TAG VALUES FROM \"receipt_read_summary\" WITH KEY=\"run_id\" WHERE \"experiment_id\" =~ /^$experiment_id$/",
        "refresh": 1,
        "sort": 2,
        "multi": false,
        "includeAll": false,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "조회 p95 — 반복 3회 중앙값",
      "description": "동일 100 RPS, 매 실행 재시작·30초 준비 부하·60초 측정, 전후 각 3회. 10개 테스트 계정의 완료 영수증 50개를 반복 조회합니다.",
      "datasource": {
        "type": "influxdb",
        "uid": "receipt-loadtest-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "receipt-loadtest-influx"
          },
          "rawQuery": true,
          "query": "SELECT last(\"p95_median_ms\") FROM \"receipt_read_comparison\" WHERE \"experiment_id\" =~ /^$experiment_id$/ GROUP BY \"phase\"",
          "resultFormat": "time_series",
          "alias": "$tag_phase"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "before"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "개선 전"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
