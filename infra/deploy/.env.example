# 준비 (프로젝트 루트에서):
#   cp infra/deploy/.env.example infra/deploy/.env
#   chmod 600 infra/deploy/.env
# 실제 값은 .env에만 입력합니다. .env는 Git과 이미지 빌드에서 제외됩니다.
# 비밀번호/API 키에 $ 또는 #이 포함되면 값 전체를 작은따옴표로 감싸세요.

# 서로 다른 충분히 긴 비밀번호를 입력합니다. 첫 실행 때 DB 계정을 생성합니다.
# 이미 DB가 생성된 뒤 이 값만 바꾸면 DB 비밀번호가 함께 변경되지는 않습니다.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 버킷은 미리 생성되어 있어야 합니다. 운영에서 사용할 버킷으로 설정합니다.
RECEIPT_S3_BUCKET=receipt-expense-dev-sanghwa-20261010
RECEIPT_S3_REGION=ap-northeast-2
RECEIPT_S3_PREFIX=receipt-images
# EC2에는 이 경로의 s3:GetObject/PutObject 권한을 가진 IAM 역할을 연결합니다.
# AWS SDK가 역할의 임시 인증 정보를 사용하므로 AWS 액세스 키는 넣지 않습니다.
# EC2의 IMDSv2를 컨테이너에서 사용하려면 메타데이터 응답 hop limit을 2로 설정합니다.

RECEIPT_EXTRACTOR_PROVIDER=openai
# openai를 사용할 때 필수입니다. 비어 있으면 실제 영수증 추출에 실패합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com
# 외부 AI 호출 없이 연결만 확인할 때는 provider=fake로 변경합니다.

# 처음에는 서버 내부/SSH 터널로 접속합니다. 공개 접속용 HTTPS 구성은 다음 단계입니다.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# 앱 컨테이너의 메모리 한도입니다. 서버에는 MySQL/Redis용 메모리도 필요합니다.
APP_MEMORY_LIMIT=1g
# HTTPS에서는 true. SSH 터널 등 로컬 HTTP 확인 때만 false로 설정합니다.
SESSION_COOKIE_SECURE=true
SESSION_REDIS_NAMESPACE=receipt:session
SESSION_TIMEOUT=30m
RECEIPT_WORKER_CONCURRENCY=4
RECEIPT_WORKER_BATCH_SIZE=4
APP_IMAGE_TAG=local

# 실행 순서:
#   ./scripts/deploy.sh build
#   ./scripts/deploy.sh bootstrap    # 새 DB의 첫 관리자만 생성, 비밀번호를 숨겨서 입력
#   ./scripts/deploy.sh up
#   ./scripts/deploy.sh status
#   ./scripts/deploy.sh logs
#   ./scripts/deploy.sh down         # 컨테이너만 제거, DB/Redis 볼륨 보존
